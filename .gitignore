# The v1 rules above (*.json, lib/) must not swallow v2 source files.
!web/**/*.json
!web/lib/
!web/lib/**
# Suite fixtures are demo data (AGENTS.md §8), not local data.
!web/fixtures/suite/*.csv
!web/fixtures/suite/*.xlsx

